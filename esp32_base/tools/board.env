# One place for the board settings, read by build_firmware.sh and upload_firmware.sh.
# Board: ESP32-S3 (QFN56) rev v0.2, 16 MB quad flash, 8 MB octal PSRAM ("N16R8"), read with esptool 2026-11-20.
ARDUINO_CONFIG="$HOME/work/tools/arduino/arduino-cli.yaml"
BUILD_ROOT="$HOME/work/tools/arduino/build"
FQBN="esp32:esp32:esp32s3:FlashSize=16M,PSRAM=opi,CDCOnBoot=cdc,USBMode=hwcdc,PartitionScheme=app3M_fat9M_16MB"
# USB id of the board's native port, both in download mode and when a Duet sketch runs (USB-Serial/JTAG).
USB_VID=303A
USB_PID=1001
