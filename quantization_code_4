// Note stability (this is what fixes the "waver" at note changes):
// a new note is only started once the last SETTLE_FRAMES pitch readings are all
// voiced AND lie within SETTLE_SPREAD semitones of each other (i.e. the voice has
// stopped sliding). The note chosen is the MEDIAN of those readings.
// Each frame is 16 ms, so 5 frames = 80 ms. Higher = steadier but more latency.
constexpr int   SETTLE_FRAMES  = 5;
constexpr float SETTLE_SPREAD  = 0.6f;   // semitones
constexpr int   RELEASE_FRAMES = 6;      // unvoiced frames (~100 ms) before note-off

// Clean-up applied to the recording when you stop it (the live MIDI can't be un-played):
constexpr uint32_t MIN_NOTE_MS  = 100;   // notes shorter than this are treated as blips and dropped
constexpr uint32_t MERGE_GAP_MS = 120;   // same pitch re-triggered within this gap -> one note

