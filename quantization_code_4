// ---------------- Recording helpers ----------------
void recordEvent(bool on, int note, int vel) {
  bool appended = false;
  MidiEvt e{};
  portENTER_CRITICAL(&recMux);
  if (recState == REC_RECORDING) {
    uint32_t t = millis() - recStartMs;
    if (on) {
      if (evtCount < MAX_EVENTS - 1) {            // keep space for matching note-off
        e = MidiEvt{t, (uint8_t)note, (uint8_t)vel, 1, 0};
        evts[evtCount++] = e;
        recNoteOpen = true;
        recNote = (uint8_t)note;
        appended = true;
      }
    } else if (recNoteOpen) {
      e = MidiEvt{t, recNote, 0, 0, 0};
      evts[evtCount++] = e;
      recNoteOpen = false;
      appended = true;
    }
  }
  portEXIT_CRITICAL(&recMux);
  if (appended) sendLive(e.on ? 'N' : 'F', e.ms, e.note, e.vel);
}

bool startRecording() {
  if (!beginBackup()) return false;
  activeSession = esp_random();
  portENTER_CRITICAL(&recMux);
  evtCount = 0;
  recNoteOpen = false;
  recStartMs = millis();
  portEXIT_CRITICAL(&recMux);
  sendLive('S', 0);           // announce session start to the browser
  recState = REC_RECORDING;
  return true;
}

void stopRecording() {
  bool closedNote = false;
  MidiEvt finalOff{};
  uint32_t stopMs;
  portENTER_CRITICAL(&recMux);
  stopMs = millis() - recStartMs;
  if (recNoteOpen && evtCount < MAX_EVENTS) {
    finalOff = MidiEvt{stopMs, recNote, 0, 0, 0};
    evts[evtCount++] = finalOff;
    closedNote = true;
  }
  recNoteOpen = false;
  recState = REC_SAVING;                         // prevent concurrent append
  portEXIT_CRITICAL(&recMux);
  if (closedNote) sendLive('F', finalOff.ms, finalOff.note, 0);
  sendLive('E', stopMs);
}

bool mountSD() {
  SPI.begin(PIN_SD_CLK, PIN_SD_MISO, PIN_SD_MOSI, PIN_SD_CS);
  const uint32_t speeds[] = {10000000, 4000000, 1000000};   // fall back to slower clocks
  for (uint32_t hz : speeds) {
    if (SD.begin(PIN_SD_CS, SPI, hz)) {
      Serial.printf("SD mounted at %u Hz, card type %d, size %llu MB\n",
                    (unsigned)hz, (int)SD.cardType(),
                    (unsigned long long)(SD.cardSize() / (1024ULL * 1024ULL)));
      return true;
    }
    Serial.printf("SD mount failed at %u Hz\n", (unsigned)hz);
    SD.end();
  }
  return false;
}

// Tidy the recorded notes: drop blips, then merge re-triggered repeats of the same pitch.
// Events are strictly on/off pairs (the voice is monophonic), so pair i = events 2i, 2i+1.
void cleanRecording() {
  int n = evtCount / 2;

  // pass 1: drop notes shorter than MIN_NOTE_MS
  int w = 0;
  for (int i = 0; i < n; i++) {
    MidiEvt on  = evts[2 * i];
    MidiEvt off = evts[2 * i + 1];
    if (off.ms - on.ms < MIN_NOTE_MS) continue;
    evts[2 * w]     = on;
    evts[2 * w + 1] = off;
    w++;
  }
  n = w;

  // pass 2: merge same-pitch notes separated by a tiny gap
  w = 0;
  for (int i = 0; i < n; i++) {
    MidiEvt on  = evts[2 * i];
    MidiEvt off = evts[2 * i + 1];
    if (w > 0 && evts[2 * (w - 1)].note == on.note &&
        on.ms - evts[2 * (w - 1) + 1].ms <= MERGE_GAP_MS) {
      evts[2 * (w - 1) + 1].ms = off.ms;           // extend the previous note
    } else {
      evts[2 * w]     = on;
      evts[2 * w + 1] = off;
      w++;
    }
  }
  evtCount = 2 * w;
}

// MIDI variable-length quantity
static size_t putVlq(uint8_t* p, uint32_t v) {
  uint8_t tmp[5];
  int n = 0;
  tmp[n++] = v & 0x7F;
  while ((v >>= 7)) tmp[n++] = (v & 0x7F) | 0x80;
  size_t k = 0;
  while (n--) p[k++] = tmp[n];
  return k;
}

SaveResult saveMidi(char* fname, size_t fnameLen, int& nNotes, uint32_t& durMs) {
  nNotes = 0; durMs = 0;
  int before = evtCount / 2;
  cleanRecording();
  Serial.printf("Clean-up: %d raw notes -> %d notes\n", before, evtCount / 2);
  int n = evtCount;
  for (int i = 0; i < n; i++) if (evts[i].on) nNotes++;
  if (nNotes == 0) return SAVE_EMPTY;
  durMs = evts[n - 1].ms;

  if (!sdReady) sdReady = mountSD();
  if (!sdReady) return SAVE_NO_SD;

  char path[32];
  if (takeIndex < 1 || takeIndex > 999) return SAVE_FAIL;
  snprintf(fname, fnameLen, "take%03d.mid", takeIndex);
  snprintf(path, sizeof path, "/%s", fname);
  if (SD.exists(path)) return SAVE_FAIL; // never overwrite an older recording

  size_t p = 0;
  auto put8  = [&](uint8_t v)  { fbuf[p++] = v; };
  auto put16 = [&](uint16_t v) { put8(v >> 8); put8(v & 0xFF); };
  auto put32 = [&](uint32_t v) { put8(v >> 24); put8(v >> 16); put8(v >> 8); put8(v); };

  memcpy(fbuf + p, "MThd", 4); p += 4;
  put32(6); put16(0); put16(1); put16(MIDI_PPQ);          // format 0, 1 track

  memcpy(fbuf + p, "MTrk", 4); p += 4;
  size_t lenPos = p; put32(0);                            // length patched below
  size_t trackStart = p;

  put8(0x00); put8(0xFF); put8(0x51); put8(0x03);         // tempo 500000 us/qn = 120 BPM
  put8(0x07); put8(0xA1); put8(0x20);

  uint32_t prevTick = 0;
  for (int i = 0; i < n; i++) {
    uint32_t tick = (uint32_t)((uint64_t)evts[i].ms * TICKS_PER_SEC / 1000);
    p += putVlq(fbuf + p, tick - prevTick);
    prevTick = tick;
    if (evts[i].on) { put8(0x90 | (MIDI_CHANNEL - 1)); put8(evts[i].note); put8(evts[i].vel); }
    else            { put8(0x80 | (MIDI_CHANNEL - 1)); put8(evts[i].note); put8(0); }
  }
  put8(0x00); put8(0xFF); put8(0x2F); put8(0x00);         // end of track

  uint32_t trackLen = p - trackStart;
  fbuf[lenPos + 0] = trackLen >> 24; fbuf[lenPos + 1] = trackLen >> 16;
  fbuf[lenPos + 2] = trackLen >> 8;  fbuf[lenPos + 3] = trackLen;

  File f = SD.open(path, FILE_WRITE);
  if (!f) { sdReady = false; return SAVE_FAIL; }
  size_t w = f.write(fbuf, p);
  f.close();
  if (w != p) return SAVE_FAIL;
  Serial.printf("Saved %s (%u bytes, %d notes)\n", path, (unsigned)p, nNotes);
  return SAVE_OK;
}

// ---------------- Playback: tiny MIDI reader ----------------
// Reads format-0 / first-track note data, i.e. the files this device writes.
// BEGIN-PARSER
static uint32_t be32(const uint8_t* p) {
  return ((uint32_t)p[0] << 24) | ((uint32_t)p[1] << 16) | ((uint32_t)p[2] << 8) | p[3];
}
static uint16_t be16(const uint8_t* p) { return (uint16_t)((p[0] << 8) | p[1]); }

static bool readVlq(MidiPlayer& m, uint32_t& out) {
  out = 0;
  for (int i = 0; i < 4; i++) {
    if (m.p >= m.end) return false;
    uint8_t b = *m.p++;
    out = (out << 7) | (b & 0x7F);
    if (!(b & 0x80)) return true;
  }
  return false;
}

static bool midiOpen(MidiPlayer& m, const uint8_t* buf, size_t len) {
  if (len < 22 || memcmp(buf, "MThd", 4) != 0) return false;
  uint32_t hdrLen = be32(buf + 4);
  uint16_t div = be16(buf + 12);
  if (hdrLen < 6 || (div & 0x8000) || div == 0) return false;   // SMPTE timing not supported
  const uint8_t* end = buf + len;
  const uint8_t* p = buf + 8 + hdrLen;
  while (p + 8 <= end) {
    uint32_t clen = be32(p + 4);
    if (memcmp(p, "MTrk", 4) == 0) {
      m.p = p + 8;
      m.end = (p + 8 + clen <= end) ? (p + 8 + clen) : end;
      m.ppq = div;
      m.tempo = 500000;
      m.timeUs = 0;
      m.running = 0;
      return true;
    }
    p += 8 + clen;
  }
  return false;
}

// Finds the next note-on / note-off. m.timeUs is the event's time when it returns true.
static bool nextNoteEvent(MidiPlayer& m, uint8_t& note, uint8_t& vel, bool& on) {
  for (;;) {
    uint32_t delta;
    if (!readVlq(m, delta)) return false;
    if (m.tempo == 0) m.tempo = 500000;
    m.timeUs += (uint64_t)delta * m.tempo / m.ppq;
    if (m.p >= m.end) return false;

    uint8_t status = *m.p;
    if (status & 0x80) {
      m.p++;
    } else {
      if (m.running < 0x80) return false;          // data byte with no running status: corrupt
      status = m.running;
    }

    if (status == 0xFF) {                          // meta event
      if (m.p >= m.end) return false;
      uint8_t type = *m.p++;
      uint32_t len;
      if (!readVlq(m, len)) return false;
      if (m.p + len > m.end) return false;
      if (type == 0x2F) return false;              // end of track
      if (type == 0x51 && len == 3)
        m.tempo = ((uint32_t)m.p[0] << 16) | ((uint32_t)m.p[1] << 8) | m.p[2];
      m.p += len;
      m.running = 0;
      continue;
    }
    if (status == 0xF0 || status == 0xF7) {        // sysex
      uint32_t len;
      if (!readVlq(m, len)) return false;
      if (m.p + len > m.end) return false;
      m.p += len;
      m.running = 0;
      continue;
    }
    if (status >= 0xF1) return false;              // other system messages: not expected

    m.running = status;
    uint8_t type = status & 0xF0;
    int dataLen = (type == 0xC0 || type == 0xD0) ? 1 : 2;
    if (m.p + dataLen > m.end) return false;
    uint8_t d1 = m.p[0];
    uint8_t d2 = (dataLen == 2) ? m.p[1] : 0;
    m.p += dataLen;

    if (type == 0x90 && d2 > 0) { note = d1; vel = d2; on = true;  return true; }
    if (type == 0x80 || type == 0x90) { note = d1; vel = 0; on = false; return true; }
    // anything else (program change, controllers, ...) is ignored
  }
}
