void handleRoot() {
  webServer.send_P(200, "text/html; charset=utf-8", INDEX_HTML);
}

void handleState() {
  uint32_t seq;
  portENTER_CRITICAL(&liveMux);
  seq = liveSequence;
  portEXIT_CRITICAL(&liveMux);
  String reply = String("{\"seq\":") + String(seq) +
    ",\"recording\":" + (recState == REC_RECORDING ? "true" : "false") +
    ",\"sd\":" + (sdReady ? "true" : "false") +
    ",\"playing\":" + (playState != PLAY_IDLE ? "true" : "false") + "}";
  webServer.send(200, "application/json", reply);
}

void handleEvents() {
  uint32_t since = webServer.hasArg("since") ? (uint32_t)strtoul(webServer.arg("since").c_str(), nullptr, 10) : 0;
  uint32_t latest;
  portENTER_CRITICAL(&liveMux);
  latest = liveSequence;
  portEXIT_CRITICAL(&liveMux);
  const uint32_t oldest = latest >= LIVE_CAPACITY ? latest - LIVE_CAPACITY + 1 : 1;
  bool overflow = (since < oldest - 1);
  uint32_t first = since + 1;
  if (first < oldest) first = oldest;
  uint32_t last = latest;
  if (first <= latest && last - first >= 47) last = first + 47; // bound each response

  String reply;
  reply.reserve(4400);
  reply = String("{\"overflow\":") + (overflow ? "true" : "false") + ",\"events\":[";
  bool comma = false;
  for (uint32_t seq = first; seq <= last && seq > 0; seq++) {
    LivePacket e;
    portENTER_CRITICAL(&liveMux);
    e = liveEvents[seq % LIVE_CAPACITY];
    portEXIT_CRITICAL(&liveMux);
    if (e.seq != seq) continue; // overwritten concurrently
    if (comma) reply += ',';
    comma = true;
    char line[140];
    snprintf(line, sizeof line,
        "{\"seq\":%lu,\"session\":%lu,\"ms\":%lu,\"type\":\"%c\",\"note\":%u,\"velocity\":%u}",
        (unsigned long)e.seq, (unsigned long)e.session, (unsigned long)e.ms,
        e.type, (unsigned)e.note, (unsigned)e.velocity);
    reply += line;
  }
  reply += "]}";
  webServer.sendHeader("Cache-Control", "no-store");
  webServer.send(200, "application/json", reply);
}

void handleDownloadMidi() {
  if (!sdReady || recState != REC_IDLE || playState != PLAY_IDLE) {
    webServer.send(409, "text/plain; charset=utf-8", "SD card unavailable or recording/playback still running");
    return;
  }
  if (!latestSavedMidi[0]) {
    webServer.send(404, "text/plain; charset=utf-8", "No MIDI recording on SD yet");
    return;
  }
  String path = String("/") + latestSavedMidi;
  File f = SD.open(path, FILE_READ);
  if (!f) {
    webServer.send(404, "text/plain; charset=utf-8", "MIDI file not found");
    return;
  }
  webServer.sendHeader("Content-Disposition", String("attachment; filename=\"") + latestSavedMidi + "\"");
  webServer.sendHeader("Cache-Control", "no-store");
  webServer.streamFile(f, "audio/midi");
  f.close();
}

void networkTask(void*) {
  WiFi.mode(WIFI_AP_STA);
  WiFi.setSleep(false);
  if (!WiFi.softAP(AP_SSID, AP_PASSWORD)) Serial.println("ERROR: ESP32 Wi-Fi AP failed");
  Serial.printf("Wi-Fi AP: %s / password: %s / browser: http://%s\n",
                AP_SSID, AP_PASSWORD, WiFi.softAPIP().toString().c_str());
  if (strlen(OPTIONAL_WIFI_SSID) > 0) {
    WiFi.begin(OPTIONAL_WIFI_SSID, OPTIONAL_WIFI_PASSWORD);
    Serial.printf("Optional STA connecting: %s\n", OPTIONAL_WIFI_SSID);
  }
  webServer.on("/", HTTP_GET, handleRoot);
  webServer.on("/api/state", HTTP_GET, handleState);
  webServer.on("/api/events", HTTP_GET, handleEvents);
  webServer.on("/api/midi", HTTP_GET, handleDownloadMidi);
  webServer.onNotFound([](){webServer.send(404, "text/plain", "Not found");});
  webServer.begin();
  Serial.println("MIDI web server ready on port 80");
  for (;;) {
    webServer.handleClient();
    vTaskDelay(pdMS_TO_TICKS(5));
  }
}


// Discover highest numbered MIDI on SD at boot (does not change existing files).
void findLatestOnBoot() {
  if (!sdReady) return;
  int best = -1;
  File root = SD.open("/");
  if (!root) return;
  File f = root.openNextFile();
  while (f) {
    if (!f.isDirectory()) {
      const char* nm = f.name();
      const char* base = strrchr(nm, '/');
      base = base ? base + 1 : nm;
      if (strlen(base) == 11 && strncasecmp(base, "take", 4) == 0 &&
          strcasecmp(base + 7, ".mid") == 0) {
        int id = atoi(base + 4);
        if (id > best) {
          best = id;
          snprintf(latestSavedMidi, sizeof latestSavedMidi, "%s", base);
        }
      }
    }
    f = root.openNextFile();
  }
  root.close();
}

// ---------------- Arduino entry points ----------------
void setup() {
  Serial.begin(115200);
  pinMode(PIN_BUTTON, INPUT_PULLUP);

#if USE_USB_MIDI
  MIDI.begin();
  USB.begin();
#endif

  Wire.begin(PIN_OLED_SDA, PIN_OLED_SCL);
  Wire.setClock(400000);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED not found - check wiring / address / SDA pin");
  }
  display.clearDisplay();
  display.display();

  sdReady = mountSD();
  Serial.println(sdReady ? "SD card ready" : "SD card NOT found (will retry when recording)");
  findLatestOnBoot();

  xTaskCreatePinnedToCore(networkTask, "web", 10240, nullptr, 1, nullptr, 0);

  i2s.setPins(PIN_MIC_BCLK, PIN_MIC_WS, -1, PIN_MIC_DIN);
  if (!i2s.begin(I2S_MODE_STD, SAMPLE_RATE, I2S_DATA_BIT_WIDTH_32BIT,
                 I2S_SLOT_MODE_MONO, I2S_STD_SLOT_LEFT)) {
    Serial.println("I2S init failed");
    while (true) delay(1000);
  }

  xTaskCreatePinnedToCore(audioTask, "audio", 8192, nullptr, 3, nullptr, 1);
  buildWave();
  xTaskCreatePinnedToCore(playTask,  "play",  8192, nullptr, 2, &playTaskHandle, 0);
  xTaskCreatePinnedToCore(uiTask,    "ui",    6144, nullptr, 1, nullptr, 0);
}

void loop() {
  vTaskDelete(nullptr);
}
