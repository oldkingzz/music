// ---------------- Playback: small additive synth ----------------
void buildWave() {
  const float harm[] = {1.0f, 0.55f, 0.35f, 0.22f, 0.14f, 0.09f, 0.05f, 0.03f};
  float peak = 0.0f;
  for (int i = 0; i < WAVE_N; i++) {
    float x = 2.0f * (float)M_PI * (float)i / (float)WAVE_N;
    float s = 0.0f;
    for (int h = 0; h < 8; h++) s += harm[h] * sinf((float)(h + 1) * x);
    wave[i] = s;
    if (fabsf(s) > peak) peak = fabsf(s);
  }
  for (int i = 0; i < WAVE_N; i++) wave[i] /= peak;
  wave[WAVE_N] = wave[0];                          // guard point for interpolation
}

static void voiceNoteOn(uint8_t note, uint8_t vel) {
  int slot = -1;
  for (int i = 0; i < NUM_VOICES; i++) if (!voices[i].active) { slot = i; break; }
  if (slot < 0) for (int i = 0; i < NUM_VOICES; i++) if (!voices[i].gate) { slot = i; break; }
  if (slot < 0) slot = 0;
  float freq = 440.0f * powf(2.0f, ((float)note - 69.0f) / 12.0f);
  Voice& v = voices[slot];
  v.active = true;
  v.gate   = true;
  v.note   = note;
  v.phase  = 0;
  v.inc    = (uint32_t)((double)freq * 4294967296.0 / (double)PLAY_RATE);
  v.amp    = 0.3f + 0.7f * ((float)vel / 127.0f);
  v.attack = 0.0f;
  v.decay  = 1.0f;
  v.rel    = 1.0f;
}

static void voiceNoteOff(uint8_t note) {
  for (int i = 0; i < NUM_VOICES; i++) {
    if (voices[i].active && voices[i].gate && voices[i].note == note) { voices[i].gate = false; return; }
  }
}

static bool voicesIdle() {
  for (int i = 0; i < NUM_VOICES; i++) if (voices[i].active) return false;
  return true;
}

static float renderVoices() {
  static const float ATTACK_STEP  = 1.0f / (ATTACK_SEC * (float)PLAY_RATE);
  static const float DECAY_FACTOR = expf(-1.0f / (DECAY_TAU_SEC * (float)PLAY_RATE));
  static const float REL_NORMAL   = expf(-1.0f / (RELEASE_TAU_SEC * (float)PLAY_RATE));
  static const float REL_FAST     = expf(-1.0f / (0.008f * (float)PLAY_RATE));
  const uint32_t FRAC_BITS = 32 - WAVE_BITS;
  const uint32_t FRAC_MASK = (1u << FRAC_BITS) - 1u;
  const float    FRAC_SCALE = 1.0f / (float)(1u << FRAC_BITS);

  float acc = 0.0f;
  for (int k = 0; k < NUM_VOICES; k++) {
    Voice& v = voices[k];
    if (!v.active) continue;

    uint32_t idx = v.phase >> FRAC_BITS;
    float frac = (float)(v.phase & FRAC_MASK) * FRAC_SCALE;
    float s = wave[idx] + (wave[idx + 1] - wave[idx]) * frac;
    v.phase += v.inc;

    if (v.attack < 1.0f) { v.attack += ATTACK_STEP; if (v.attack > 1.0f) v.attack = 1.0f; }
    if (v.gate) {
      if (v.decay > DECAY_FLOOR) v.decay *= DECAY_FACTOR;
    } else {
      v.rel *= fastRelease ? REL_FAST : REL_NORMAL;
      if (v.rel < 0.0005f) { v.active = false; continue; }
    }
    acc += s * v.attack * v.decay * v.rel * v.amp;
  }
  return acc;
}

static bool writeBlock(const int16_t* buf, size_t frames) {
  const uint8_t* b = (const uint8_t*)buf;
  size_t total = frames * 4, off = 0;               // 16-bit stereo = 4 bytes per frame
  while (off < total) {
    size_t n = spk.write(b + off, total - off);
    if (n == 0) return false;
    off += n;
  }
  return true;
}

// ---------------- Playback: find newest take, load it, play it ----------------
static int playLatestTake() {
  if (!sdReady) sdReady = mountSD();
  if (!sdReady) return PLAYRES_NO_SD;

  // newest = highest number in take###.mid (the device numbers its takes sequentially)
  int best = -1;
  File root = SD.open("/");
  if (!root) { sdReady = false; return PLAYRES_NO_SD; }
  File f = root.openNextFile();
  while (f) {
    if (!f.isDirectory()) {
      const char* nm = f.name();
      const char* base = strrchr(nm, '/');
      base = base ? base + 1 : nm;
      size_t L = strlen(base);
      if (L >= 9 && strncasecmp(base, "take", 4) == 0 && strcasecmp(base + L - 4, ".mid") == 0) {
        int n = atoi(base + 4);
        if (n > best) best = n;
      }
    }
    f = root.openNextFile();
  }
  root.close();
  if (best < 0) return PLAYRES_NO_FILES;

  snprintf(playName, sizeof playName, "take%03d.mid", best);
  char path[24];
  snprintf(path, sizeof path, "/%s", playName);

  File mf = SD.open(path, FILE_READ);
  if (!mf) return PLAYRES_BAD_FILE;
  size_t size = mf.size();
  if (size < 22 || size > sizeof(fbuf)) { mf.close(); return PLAYRES_BAD_FILE; }
  size_t got = mf.read(fbuf, size);
  mf.close();
  if (got != size) return PLAYRES_BAD_FILE;

  MidiPlayer m;
  if (!midiOpen(m, fbuf, size)) return PLAYRES_BAD_FILE;

  // pre-scan for the total length
  MidiPlayer scan = m;
  uint8_t note, vel; bool on;
  uint64_t totalUs = 0;
  while (nextNoteEvent(scan, note, vel, on)) totalUs = scan.timeUs;
  if (totalUs == 0) return PLAYRES_BAD_FILE;
  playDurMs = (uint32_t)(totalUs / 1000ULL);
  playPosMs = 0;

  // speaker I2S (TX only), opened just for the duration of playback
  spk.setPins(PIN_SPK_BCLK, PIN_SPK_LRC, PIN_SPK_DIN);
  if (!spk.begin(I2S_MODE_STD, PLAY_RATE, I2S_DATA_BIT_WIDTH_16BIT,
                 I2S_SLOT_MODE_STEREO, I2S_STD_SLOT_BOTH)) {
    return PLAYRES_I2S;
  }

  for (int i = 0; i < NUM_VOICES; i++) voices[i].active = false;
  fastRelease = false;

  static int16_t out[PLAY_BLOCK * 2];
  memset(out, 0, sizeof out);
  writeBlock(out, PLAY_BLOCK);                       // a little silence first
  writeBlock(out, PLAY_BLOCK);
  playState = PLAY_PLAYING;

  uint64_t sampleCounter = 0;
  bool haveEvt = nextNoteEvent(m, note, vel, on);
  uint64_t evtSample = haveEvt ? (m.timeUs * PLAY_RATE / 1000000ULL) : 0;
  bool ok = true;

  while (!playStop && ok) {
    for (int i = 0; i < PLAY_BLOCK; i++) {
      while (haveEvt && evtSample <= sampleCounter) {
        if (on) voiceNoteOn(note, vel); else voiceNoteOff(note);
        haveEvt = nextNoteEvent(m, note, vel, on);
        if (haveEvt) evtSample = m.timeUs * PLAY_RATE / 1000000ULL;
      }
      float s = renderVoices() * PLAY_VOLUME;
      if (s > 1.0f) s = 1.0f; else if (s < -1.0f) s = -1.0f;
      int16_t v16 = (int16_t)(s * 32767.0f);
      out[2 * i] = v16;
      out[2 * i + 1] = v16;
      sampleCounter++;
    }
    ok = writeBlock(out, PLAY_BLOCK);
    playPosMs = (uint32_t)(sampleCounter * 1000ULL / PLAY_RATE);
    if (!haveEvt && voicesIdle()) break;             // finished, tails have died away
  }

  if (playStop) {                                    // quick fade-out so stopping doesn't click
    for (int i = 0; i < NUM_VOICES; i++) voices[i].gate = false;
    fastRelease = true;
    for (int blk = 0; blk < 30 && !voicesIdle() && ok; blk++) {
      for (int i = 0; i < PLAY_BLOCK; i++) {
        float s = renderVoices() * PLAY_VOLUME;
        if (s > 1.0f) s = 1.0f; else if (s < -1.0f) s = -1.0f;
        int16_t v16 = (int16_t)(s * 32767.0f);
        out[2 * i] = v16;
        out[2 * i + 1] = v16;
      }
      ok = writeBlock(out, PLAY_BLOCK);
    }
  }

  memset(out, 0, sizeof out);
  writeBlock(out, PLAY_BLOCK);                       // trailing silence, then release the port
  writeBlock(out, PLAY_BLOCK);
  spk.end();
  return PLAYRES_OK;
}

void playTask(void*) {
  for (;;) {
    ulTaskNotifyTake(pdTRUE, portMAX_DELAY);         // sleep until the UI asks for playback
    int r = playLatestTake();
    playResult = r;
    playState = PLAY_IDLE;
  }
}

void startPlayback() {
  playStop = false;
  playResult = PLAYRES_NONE;
  playState = PLAY_LOADING;
  if (playTaskHandle) xTaskNotifyGive(playTaskHandle);
  else playState = PLAY_IDLE;
}

// ---------------- Live MIDI helpers ----------------
void midiSendOff() {
  if (!midiSounding) return;
#if USE_USB_MIDI
  MIDI.noteOff(midiSoundingNote, 0, MIDI_CHANNEL);
#endif
  Serial.printf("NOTE OFF %3d\n", midiSoundingNote);
  midiSounding = false;
  midiSoundingNote = -1;
}

void midiNoteOff() {
  recordEvent(false, 0, 0);       // recorded even when live output is muted
  midiSendOff();
}

void midiNoteOn(int n, int vel) {
  recordEvent(true, n, vel);
  if (!midiEnabled) return;
#if USE_USB_MIDI
  MIDI.noteOn(n, vel, MIDI_CHANNEL);
#endif
  char nm[8]; noteName(n, nm, sizeof nm);
  Serial.printf("NOTE ON  %3d (%s) vel %d\n", n, nm, vel);
  midiSounding = true;
  midiSoundingNote = n;
}

// ---------------- YIN pitch detector ----------------
float yinPitch(const float* x, float& confidence) {
  static float d[TAU_MAX + 2];
  d[0] = 1.0f;
  float running = 0.0f;

  for (int tau = 1; tau <= TAU_MAX; tau++) {
    float sum = 0.0f;
    for (int j = 0; j < W; j++) {
      float diff = x[j] - x[j + tau];
      sum += diff * diff;
    }
    running += sum;
    d[tau] = (running > 0.0f) ? (sum * tau / running) : 1.0f;
  }

  int tauEst = -1;
  for (int tau = TAU_MIN; tau <= TAU_MAX; tau++) {
    if (d[tau] < YIN_THRESHOLD) {
      while (tau + 1 <= TAU_MAX && d[tau + 1] < d[tau]) tau++;
      tauEst = tau;
      break;
    }
  }
  if (tauEst < 0) {
    float best = 1e9f;
    for (int tau = TAU_MIN; tau <= TAU_MAX; tau++) {
      if (d[tau] < best) { best = d[tau]; tauEst = tau; }
    }
  }
  if (tauEst < 1) { confidence = 0; return 0; }

  confidence = constrain(1.0f - d[tauEst], 0.0f, 1.0f);

  float tauF = (float)tauEst;
  if (tauEst > 1 && tauEst < TAU_MAX) {
    float s0 = d[tauEst - 1], s1 = d[tauEst], s2 = d[tauEst + 1];
    float denom = 2.0f * (2.0f * s1 - s2 - s0);
    if (fabsf(denom) > 1e-9f) tauF += (s2 - s0) / denom;
  }
  return (float)SAMPLE_RATE / tauF;
}

// ---------------- Audio task (core 1) ----------------
void audioTask(void*) {
  static float   frame[FRAME];
  static int32_t raw[HOP];
  memset(frame, 0, sizeof frame);

  float dc = 0.0f;
  int activeNote = -1;
  int histCount = 0;                       // consecutive voiced frames collected so far
  int unvoicedRun = 0;                     // consecutive unvoiced frames
  float pitchHist[SETTLE_FRAMES] = {0};    // recent pitch readings in fractional MIDI notes
  float rmsHist[SETTLE_FRAMES]   = {0};    // matching loudness readings

  for (;;) {
    size_t got = i2s.readBytes((char*)raw, sizeof raw);
    if (got < sizeof raw) continue;

    memmove(frame, frame + HOP, (FRAME - HOP) * sizeof(float));
    for (int i = 0; i < HOP; i++) {
      float s = (float)(raw[i] >> 8) / 8388608.0f;
      dc += 0.001f * (s - dc);
      frame[FRAME - HOP + i] = s - dc;
    }

    float e = 0;
    for (int i = 0; i < FRAME; i++) e += frame[i] * frame[i];
    float rms = sqrtf(e / FRAME);

    // 1) pitch for this frame
    float conf = 0, freq = 0, midiF = 0;
    bool voiced = false;
    if (rms >= RMS_GATE && playState == PLAY_IDLE) {   // mic would hear the speaker during playback
      float f = yinPitch(frame, conf);
      if (f > 0 && conf >= MIN_CONFIDENCE) {
        float m = 69.0f + 12.0f * log2f(f / 440.0f);
        if (m >= 0.0f && m <= 127.0f) { voiced = true; freq = f; midiF = m; }
      }
    } else {
      conf = 0;
    }

    // 2) note decision
    if (voiced) {
      unvoicedRun = 0;

      // push this reading into the history (newest at the end)
      if (histCount < SETTLE_FRAMES) histCount++;
      for (int i = 0; i < SETTLE_FRAMES - 1; i++) {
        pitchHist[i] = pitchHist[i + 1];
        rmsHist[i]   = rmsHist[i + 1];
      }
      pitchHist[SETTLE_FRAMES - 1] = midiF;
      rmsHist[SETTLE_FRAMES - 1]   = rms;

      if (histCount >= SETTLE_FRAMES) {
        float tmp[SETTLE_FRAMES];
        float lo = 1e9f, hi = -1e9f, peak = 0.0f;
        for (int i = 0; i < SETTLE_FRAMES; i++) {
          tmp[i] = pitchHist[i];
          if (tmp[i] < lo) lo = tmp[i];
          if (tmp[i] > hi) hi = tmp[i];
          if (rmsHist[i] > peak) peak = rmsHist[i];
        }

        // only act once the pitch has stopped sliding
        if (hi - lo <= SETTLE_SPREAD) {
          for (int i = 1; i < SETTLE_FRAMES; i++) {           // insertion sort for the median
            float v = tmp[i];
            int j = i - 1;
            while (j >= 0 && tmp[j] > v) { tmp[j + 1] = tmp[j]; j--; }
            tmp[j + 1] = v;
          }
          float med = tmp[SETTLE_FRAMES / 2];

          int target = (activeNote >= 0 && fabsf(med - activeNote) < HYSTERESIS)
                         ? activeNote : (int)lroundf(med);

          if (target != activeNote) {
            midiNoteOff();
            float db = 20.0f * log10f(peak + 1e-9f);
            int vel = constrain((int)lroundf(20.0f + (db + 48.0f) * (107.0f / 30.0f)), 20, 127);
            midiNoteOn(target, vel);
            activeNote = target;
          }
        }
      }
    } else {
      histCount = 0;
      if (unvoicedRun < 1000) unvoicedRun++;
      if (activeNote >= 0 && unvoicedRun >= RELEASE_FRAMES) {
        midiNoteOff();
        activeNote = -1;
      }
    }

    // muting live output mid-note must not cut the recorded note
    if (!midiEnabled && midiSounding) midiSendOff();

    UiState s;
    s.note  = activeNote;
    s.freq  = voiced ? freq : 0;
    s.cents = (activeNote >= 0 && voiced) ? constrain((midiF - activeNote) * 100.0f, -50.0f, 50.0f) : 0;
    s.conf  = conf;
    portENTER_CRITICAL(&uiMux);
    ui = s;
    portEXIT_CRITICAL(&uiMux);
  }
}

// ---------------- UI drawing ----------------
void drawUi(const UiState& s, bool recording) {
  char buf[24];
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);

  // top line
  if (recording) {
    display.fillCircle(4, 3, 3, SSD1306_WHITE);                   // recording dot
    uint32_t sec = (millis() - recStartMs) / 1000;
    display.setCursor(11, 0);
    display.printf("%u:%02u", (unsigned)(sec / 60), (unsigned)(sec % 60));
  } else {
    display.setCursor(0, 0);
    if (s.note >= 0) display.printf("MIDI %d", s.note); else display.print("MIDI --");
  }
  if (s.note >= 0 && s.freq > 0) { display.setCursor(50, 0); display.printf("%.1fHz", s.freq); }
  display.setCursor(104, 0);
  display.print(midiEnabled ? "ON" : "OFF");

  // big note name + cents
  display.setTextSize(3);
  display.setCursor(0, 12);
  if (s.note >= 0) { noteName(s.note, buf, sizeof buf); display.print(buf); }
  else display.print("--");

  if (s.note >= 0) {
    display.setTextSize(2);
    display.setCursor(78, 14);
    display.printf("%+d", (int)lroundf(s.cents));
    display.setTextSize(1);
    display.setCursor(78, 32);
    if (recording) display.printf("MIDI %d", s.note); else display.print("cents");
  }

  // tuning meter
  display.setTextSize(1);
  display.setCursor(2, 42);   display.print("-");
  display.setCursor(120, 42); display.print("+");
  display.drawFastHLine(14, 46, 101, SSD1306_WHITE);
  display.drawFastVLine(14, 42, 9, SSD1306_WHITE);
  display.drawFastVLine(64, 42, 9, SSD1306_WHITE);
  display.drawFastVLine(114, 42, 9, SSD1306_WHITE);
  if (s.note >= 0) {
    int x = 64 + (int)lroundf(s.cents);
    display.fillRect(x - 2, 41, 5, 11, SSD1306_WHITE);
  }

  // confidence bar
  display.setCursor(0, 55);
  display.print("CONF");
  display.drawRect(30, 54, 70, 9, SSD1306_WHITE);
  int w = (int)lroundf(s.conf * 66.0f);
  if (w > 0) display.fillRect(32, 56, w, 5, SSD1306_WHITE);
  display.setCursor(104, 55);
  display.printf("%3d%%", (int)lroundf(s.conf * 100.0f));

  display.display();
}

void drawCountdown(int secs) {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
