// Recoverable SD backup: incremental CSV log + finalized MIDI file.
// The CSV has the raw Note On/Off events and is flushed every 500 ms;
// the .mid is finalized at STOP with the existing short-note cleanup.
File backupLog;
char backupName[20] = "";
int takeIndex = 0;
int logWritten = 0;
uint32_t lastLogFlush = 0;
bool backupWriteFailed = false;

bool beginBackup() {
  if (!sdReady) sdReady = mountSD();
  if (!sdReady) return false;
  char midiPath[24], csvPath[24];
  takeIndex = 0;
  for (int n = 1; n <= 999; n++) {
    snprintf(midiPath, sizeof midiPath, "/take%03d.mid", n);
    snprintf(csvPath, sizeof csvPath, "/take%03d.csv", n);
    if (!SD.exists(midiPath) && !SD.exists(csvPath)) {
      takeIndex = n;
      break;
    }
  }
  if (takeIndex == 0) return false;
  snprintf(backupName, sizeof backupName, "/take%03d.csv", takeIndex);
  backupLog = SD.open(backupName, FILE_WRITE);
  if (!backupLog) return false;
  backupLog.println("time_ms,type,note,velocity");
  backupLog.flush();
  logWritten = 0;
  lastLogFlush = millis();
  backupWriteFailed = false;
  Serial.printf("SD event backup opened: %s\n", backupName);
  return true;
}

void writeBackup(bool finalFlush) {
  if (!backupLog) return;
  // Snapshot one event at a time to avoid SD operations under a critical lock.
  for (;;) {
    MidiEvt e;
    bool have = false;
    portENTER_CRITICAL(&recMux);
    if (logWritten < evtCount) {
      e = evts[logWritten++];
      have = true;
    }
    portEXIT_CRITICAL(&recMux);
    if (!have) break;
    if (backupLog.printf("%lu,%s,%u,%u\n", (unsigned long)e.ms,
                         e.on ? "on" : "off", (unsigned)e.note,
                         (unsigned)e.vel) == 0) backupWriteFailed = true;
  }
  if (finalFlush || (uint32_t)(millis() - lastLogFlush) >= 500) {
    backupLog.flush();
    lastLogFlush = millis();
  }
  if (finalFlush) {
    backupLog.close();
    Serial.printf("SD raw event backup closed: %s%s\n", backupName,
                  backupWriteFailed ? " (WRITE ERROR)" : "");
  }
}

