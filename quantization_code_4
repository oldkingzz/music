void drawPlayback() {
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(2);
  display.setCursor(0, 2);
  if (playState == PLAY_LOADING) {
    display.print("LOADING...");
    display.display();
    return;
  }
  display.print("PLAYING");

  display.setTextSize(1);
  display.setCursor(0, 24);
  display.print(playName);
  display.setCursor(80, 24);
  display.print("tap=stop");

  uint32_t pos = playPosMs, dur = playDurMs;
  if (pos > dur) pos = dur;
  display.drawRect(0, 36, 128, 9, SSD1306_WHITE);
  int w = dur ? (int)((uint64_t)pos * 124ULL / dur) : 0;
  if (w > 0) display.fillRect(2, 38, w, 5, SSD1306_WHITE);

  uint32_t ps = pos / 1000, ds = dur / 1000;
  display.setCursor(0, 52);
  display.printf("%u:%02u / %u:%02u", (unsigned)(ps / 60), (unsigned)(ps % 60),
                 (unsigned)(ds / 60), (unsigned)(ds % 60));
  display.display();
}

// ---------------- UI task (core 0): button, recording state machine, display ----------------
void uiTask(void*) {
  bool lastBtn = digitalRead(PIN_BUTTON);
  uint32_t pressStart = 0;
  bool longHandled = lastBtn == LOW;       // ignore a button already held at boot
  uint32_t countdownStart = 0;
  uint32_t msgUntil = 0;
  int clickCount = 0;                      // short clicks seen in the current double-click window
  uint32_t lastClickMs = 0;
  char m1[16] = "", m2[32] = "", m3[32] = "";

  for (;;) {
    uint32_t now = millis();
    bool b = digitalRead(PIN_BUTTON);
    bool shortPress = false, longPress = false;

    if (lastBtn == HIGH && b == LOW) { pressStart = now; longHandled = false; }
    if (b == LOW && !longHandled && now - pressStart >= LONG_PRESS_MS) { longHandled = true; longPress = true; }
    if (lastBtn == LOW && b == HIGH && !longHandled) shortPress = true;
    lastBtn = b;

    switch (recState) {
      case REC_IDLE:
        if (playState != PLAY_IDLE) {
          // playback is running: any press stops it
          if (shortPress || longPress) playStop = true;
          clickCount = 0;
        } else if (longPress) {
          clickCount = 0;
          if (!sdReady) sdReady = mountSD();
          if (!sdReady) {
            snprintf(m1, sizeof m1, "NO SD CARD");
            snprintf(m2, sizeof m2, "Insert a FAT32 card");
            snprintf(m3, sizeof m3, "and try again");
            msgUntil = now + MESSAGE_MS;
          } else {
            msgUntil = 0;
            countdownStart = now;
            recState = REC_COUNTDOWN;
          }
        } else {
          if (shortPress) { clickCount++; lastClickMs = now; }
          if (clickCount >= 2) {                                   // double click -> play newest take
            clickCount = 0;
            msgUntil = 0;
            startPlayback();
          } else if (clickCount == 1 && now - lastClickMs > DOUBLE_CLICK_MS) {
            clickCount = 0;                                        // single click -> toggle MIDI output
            midiEnabled = !midiEnabled;
          }
        }
        break;

      case REC_COUNTDOWN:
        if (shortPress) {
          recState = REC_IDLE;                                   // cancel
        } else if (now - countdownStart >= COUNTDOWN_MS) {
          if (!startRecording()) {
            recState = REC_IDLE;
            snprintf(m1, sizeof m1, "SD ERROR");
            snprintf(m2, sizeof m2, "Can't open CSV backup");
            snprintf(m3, sizeof m3, "Check SD card");
            msgUntil = millis() + MESSAGE_MS;
          }
        }
        break;

      case REC_RECORDING:
        if (shortPress || evtCount >= MAX_EVENTS - 2) {
          stopRecording();
          writeBackup(true);     // close the recoverable raw log BEFORE cleaning events
          drawMessage("SAVING...", "", "");
          char fname[16] = "";
          int nNotes = 0;
          uint32_t durMs = 0;
          SaveResult r = saveMidi(fname, sizeof fname, nNotes, durMs);
          switch (r) {
            case SAVE_OK: {
              snprintf(latestSavedMidi, sizeof latestSavedMidi, "%s", fname);
              uint32_t sec = durMs / 1000;
              snprintf(m1, sizeof m1, "SAVED!");
              snprintf(m2, sizeof m2, "%s", fname);
              snprintf(m3, sizeof m3, "%d notes  %u:%02u", nNotes, (unsigned)(sec / 60), (unsigned)(sec % 60));
              break;
            }
            case SAVE_EMPTY:
              snprintf(m1, sizeof m1, "NO NOTES");
              snprintf(m2, sizeof m2, "Nothing was sung,");
              snprintf(m3, sizeof m3, "no file written");
              break;
            case SAVE_NO_SD:
              snprintf(m1, sizeof m1, "NO SD CARD");
              snprintf(m2, sizeof m2, "Take was LOST");
              snprintf(m3, sizeof m3, "");
              break;
            default:
              snprintf(m1, sizeof m1, "SAVE FAILED");
              snprintf(m2, sizeof m2, "Check the SD card");
              snprintf(m3, sizeof m3, "");
              break;
          }
          msgUntil = millis() + MESSAGE_MS;
          recState = REC_IDLE;
        }
        break;

      default:
        break;
    }

    // SD writes happen on core 0 and never block the I2S pitch task on core 1.
    if (recState == REC_RECORDING) writeBackup(false);

    // report playback problems once playback has ended
    if (playState == PLAY_IDLE && playResult != PLAYRES_NONE) {
      int pr = playResult;
      playResult = PLAYRES_NONE;
      bool show = true;
      switch (pr) {
        case PLAYRES_NO_SD:
          snprintf(m1, sizeof m1, "NO SD CARD");
          snprintf(m2, sizeof m2, "Can't read takes");
          snprintf(m3, sizeof m3, "");
          break;
        case PLAYRES_NO_FILES:
          snprintf(m1, sizeof m1, "NO TAKES");
          snprintf(m2, sizeof m2, "Record one first");
          snprintf(m3, sizeof m3, "(long press)");
          break;
        case PLAYRES_BAD_FILE:
          snprintf(m1, sizeof m1, "BAD FILE");
          snprintf(m2, sizeof m2, "Can't read newest");
          snprintf(m3, sizeof m3, "take, or it's empty");
          break;
        case PLAYRES_I2S:
          snprintf(m1, sizeof m1, "SPK ERROR");
          snprintf(m2, sizeof m2, "Speaker I2S failed");
          snprintf(m3, sizeof m3, "to start");
          break;
        default:
          show = false;                                            // finished normally
          break;
      }
      if (show) msgUntil = millis() + MESSAGE_MS;
    }

    // draw
    if (recState == REC_COUNTDOWN) {
      int secs = 3 - (int)((now - countdownStart) / 1000);
      if (secs < 1) secs = 1;
      drawCountdown(secs);
    } else if (recState == REC_IDLE && millis() < msgUntil) {
      drawMessage(m1, m2, m3);
    } else if (playState != PLAY_IDLE) {
      drawPlayback();
    } else {
      UiState s;
      portENTER_CRITICAL(&uiMux);
      s = ui;
      portEXIT_CRITICAL(&uiMux);
      drawUi(s, recState == REC_RECORDING);
    }
    vTaskDelay(pdMS_TO_TICKS(10));
  }
}


